            <tr><td>BMI, kg/m<sup>2</sup>, mean (SD)</td><td>27.1 (4.2)</td><td>&#x2013;</td><td></td></tr>
            <tr><td>Diabetes, n (%)<xref ref-type="table-fn" rid="t1fn1"><sup>a</sup></xref></td><td>30 (25.0)</td><td>28 (23.7)</td><td>0.82</td></tr>
          </tbody>
